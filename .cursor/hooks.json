{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "bash .cursor/hooks/rose-lite-session.sh",
        "timeout": 45
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "bash .cursor/hooks/rose-lite-prompt.sh",
        "timeout": 20,
        "matcher": "UserPromptSubmit"
      }
    ],
    "preToolUse": [
      {
        "command": "bash .cursor/hooks/shunt-intercept.sh",
        "timeout": 10,
        "matcher": "Read"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "bash .cursor/hooks/shunt-intercept.sh",
        "timeout": 10
      }
    ]
  }
}
